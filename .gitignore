cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Environments
venv/
.venv/
env/

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# Secrets
.env
.env.*
!.env.example

# Datasets
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Model weights
*.pt
*.pth
*.onnx
*.safetensors
*.ckpt

# Experiment outputs
runs/
wandb/
mlruns/
outputs/
checkpoints/

# Logs
*.log
*.tmp

# OS
.DS_Store
Thumbs.db
EOF