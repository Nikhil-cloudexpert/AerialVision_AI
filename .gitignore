cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Environments
venv/
.venv/
env/

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# Secrets
.env
.env.*
!.env.example

# Datasets
datasets/*
!datasets/README.md

# Model weights
*.pt
*.pth
*.onnx
*.safetensors
*.ckpt

# Experiment outputs
runs/
wandb/
mlruns/
outputs/
checkpoints/

# Logs
*.log
*.tmp

# OS
.DS_Store
Thumbs.db
EOF
# Experimental outputs
runs/
outputs/